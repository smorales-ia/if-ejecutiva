{
    "name": "SC-IApro-LeadsScraper v1.0 - LinkedIn leads scraper (SerpAPI + Apify -> Google Sheets)",
    "flow": [
        {
            "id": 1,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "variables": [
                    { "name": "max_pages", "value": "3" },
                    { "name": "results_per_page", "value": "15" },
                    { "name": "start_offset", "value": "0" },
                    { "name": "sleep_paginacion_s", "value": "2" },
                    { "name": "sleep_perfil_s", "value": "10" },
                    { "name": "dedupe_activo", "value": "true" }
                ],
                "scope": "roundtrip"
            },
            "metadata": {
                "designer": { "x": 0, "y": 0, "name": "A.1 Set parametros" },
                "restore": {
                    "expect": {
                        "variables": { "mode": "chose" },
                        "scope": { "label": "One cycle" }
                    }
                },
                "expect": [
                    {
                        "name": "variables",
                        "spec": [
                            { "name": "name", "type": "text", "label": "Variable name", "required": true },
                            { "name": "value", "type": "any", "label": "Variable value" }
                        ],
                        "type": "array",
                        "label": "Variables"
                    },
                    {
                        "name": "scope",
                        "type": "select",
                        "label": "Variable lifetime",
                        "required": true,
                        "validate": { "enum": ["roundtrip", "execution"] }
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "google-sheets:searchRows",
            "version": 2,
            "parameters": { "__IMTCONN__": 1 },
            "mapper": {
                "mode": "select",
                "spreadsheetId": "__SPREADSHEET_ID_BUSQUEDAS__",
                "sheetId": "Busquedas",
                "includesHeaders": true,
                "filter": [
                    [
                        { "a": "F", "b": "TRUE", "o": "text:equal" }
                    ]
                ],
                "sortOrder": "asc",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
            },
            "metadata": {
                "designer": { "x": 300, "y": 0, "name": "A.2 Busquedas WHERE activa=TRUE" },
                "restore": {
                    "expect": {
                        "mode": { "label": "Select rows" },
                        "sheetId": { "label": "Busquedas" },
                        "spreadsheetId": { "label": "iapro-busquedas (__SPREADSHEET_ID_BUSQUEDAS__)" },
                        "includesHeaders": { "label": "Yes" }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "google" },
                            "label": "Google Sheets (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:google-restricted", "label": "Connection", "required": true }
                ]
            }
        },
        {
            "id": 3,
            "module": "util:SetVariable",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "estimado_serpapi",
                "scope": "execution",
                "value": "{{length(2.array) * 1.max_pages}}"
            },
            "metadata": {
                "designer": { "x": 600, "y": 0, "name": "A.3 Estima consumo SerpAPI" },
                "restore": { "expect": { "scope": { "label": "Whole execution" } } },
                "expect": [
                    { "name": "name", "type": "text", "label": "Variable name", "required": true },
                    { "name": "scope", "type": "select", "label": "Variable lifetime", "required": true, "validate": { "enum": ["roundtrip", "execution"] } },
                    { "name": "value", "type": "any", "label": "Variable value" }
                ]
            }
        },
        {
            "id": 4,
            "module": "datastore:AddReplaceRecord",
            "version": 1,
            "parameters": { "datastore": "__DATASTORE_ID__" },
            "mapper": {
                "key": "run_{{formatDate(now; \"YYYYMMDDHHmmss\")}}",
                "overwrite": true,
                "record": {
                    "estimado_serpapi": "{{3.value}}",
                    "consumo_real": "0",
                    "iniciado": "{{now}}"
                }
            },
            "metadata": {
                "designer": { "x": 900, "y": 0, "name": "A.3 Data Store: guarda estimado" },
                "restore": {
                    "expect": {
                        "datastore": { "label": "IApro Leads Scraper (__DATASTORE_ID__)" },
                        "overwrite": { "label": "Yes" }
                    }
                },
                "parameters": [
                    { "name": "datastore", "type": "datastore", "label": "Data store", "required": true }
                ]
            }
        },
        {
            "id": 5,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": { "array": "{{2.array}}" },
            "metadata": {
                "designer": { "x": 1200, "y": 0, "name": "B Iterator por busqueda" },
                "restore": {},
                "expect": [
                    { "name": "array", "type": "array", "label": "Array" }
                ]
            }
        },
        {
            "id": 6,
            "module": "util:SetVariable",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "query",
                "scope": "roundtrip",
                "value": "site:linkedin.com/in \"{{5.D}}\" \"{{5.A}}\" \"{{5.B}}\""
            },
            "metadata": {
                "designer": { "x": 1500, "y": 0, "name": "B Query builder" },
                "restore": { "expect": { "scope": { "label": "One cycle" } } },
                "expect": [
                    { "name": "name", "type": "text", "label": "Variable name", "required": true },
                    { "name": "scope", "type": "select", "label": "Variable lifetime", "required": true, "validate": { "enum": ["roundtrip", "execution"] } },
                    { "name": "value", "type": "any", "label": "Variable value" }
                ]
            }
        },
        {
            "id": 7,
            "module": "builtin:BasicRepeater",
            "version": 1,
            "parameters": {},
            "mapper": {
                "start": "1",
                "repeats": "{{1.max_pages}}",
                "step": "1"
            },
            "metadata": {
                "designer": { "x": 1800, "y": 0, "name": "C Repeater 1..max_pages" },
                "restore": {},
                "expect": [
                    { "name": "start", "type": "number", "label": "Initial value", "required": true },
                    { "name": "repeats", "type": "number", "label": "Repeats", "required": true },
                    { "name": "step", "type": "number", "label": "Step" }
                ]
            }
        },
        {
            "id": 8,
            "module": "util:SetVariable",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "start",
                "scope": "roundtrip",
                "value": "{{1.start_offset + (7.i - 1) * 1.results_per_page}}"
            },
            "metadata": {
                "designer": { "x": 2100, "y": 0, "name": "C Offset de pagina" },
                "restore": { "expect": { "scope": { "label": "One cycle" } } },
                "expect": [
                    { "name": "name", "type": "text", "label": "Variable name", "required": true },
                    { "name": "scope", "type": "select", "label": "Variable lifetime", "required": true, "validate": { "enum": ["roundtrip", "execution"] } },
                    { "name": "value", "type": "any", "label": "Variable value" }
                ]
            }
        },
        {
            "id": 9,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "ca": "",
                "qs": [
                    { "name": "engine", "value": "google" },
                    { "name": "q", "value": "{{6.value}}" },
                    { "name": "start", "value": "{{8.value}}" },
                    { "name": "num", "value": "{{1.results_per_page}}" },
                    { "name": "gl", "value": "{{5.C}}" },
                    { "name": "hl", "value": "es" },
                    { "name": "api_key", "value": "{{SERPAPI_KEY}}" }
                ],
                "url": "https://serpapi.com/search.json",
                "gzip": true,
                "method": "get",
                "headers": [],
                "timeout": "",
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "bodyType": "",
                "contentType": "",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "onerror": [
                {
                    "id": 91,
                    "module": "builtin:Break",
                    "version": 1,
                    "parameters": {
                        "retry": true,
                        "count": "3",
                        "interval": "1",
                        "enabled": true
                    },
                    "mapper": {},
                    "metadata": {
                        "designer": { "x": 2100, "y": 300, "name": "Break SerpAPI 429/5xx (1s->3s->9s)" },
                        "restore": {},
                        "expect": [
                            { "name": "retry", "type": "boolean", "label": "Automatically complete execution" },
                            { "name": "count", "type": "number", "label": "Number of attempts" },
                            { "name": "interval", "type": "number", "label": "Interval between attempts (minutes)" }
                        ]
                    }
                }
            ],
            "metadata": {
                "designer": { "x": 2400, "y": 0, "name": "C SerpAPI GET search.json" },
                "restore": {
                    "expect": {
                        "qs": { "mode": "chose" },
                        "method": { "mode": "chose", "label": "GET" },
                        "headers": { "mode": "chose" },
                        "bodyType": { "mode": "chose" },
                        "contentType": { "mode": "chose" }
                    }
                },
                "parameters": [
                    { "name": "handleErrors", "type": "boolean", "label": "Evaluate all states as errors (except for 2xx and 3xx )", "required": true },
                    { "name": "useNewZLibDeCompress", "type": "hidden" }
                ],
                "expect": [
                    { "name": "url", "type": "url", "label": "URL", "required": true },
                    { "name": "serializeUrl", "type": "boolean", "label": "Serialize URL", "required": true },
                    { "name": "method", "type": "select", "label": "Method", "required": true, "validate": { "enum": ["get", "head", "post", "put", "patch", "delete", "options"] } },
                    { "name": "headers", "spec": [ { "name": "name", "type": "text", "label": "Name", "required": true }, { "name": "value", "type": "text", "label": "Value" } ], "type": "array", "label": "Headers" },
                    { "name": "qs", "spec": [ { "name": "name", "type": "text", "label": "Name", "required": true }, { "name": "value", "type": "text", "label": "Value" } ], "type": "array", "label": "Query String" },
                    { "name": "bodyType", "type": "select", "label": "Body type", "validate": { "enum": ["raw", "x_www_form_urlencoded", "multipart_form_data"] } },
                    { "name": "parseResponse", "type": "boolean", "label": "Parse response", "required": true },
                    { "name": "authUser", "type": "text", "label": "User name" },
                    { "name": "authPass", "type": "password", "label": "Password" },
                    { "name": "timeout", "type": "uinteger", "label": "Timeout", "validate": { "max": 300, "min": 1 } },
                    { "name": "shareCookies", "type": "boolean", "label": "Share cookies with other HTTP modules", "required": true },
                    { "name": "ca", "type": "cert", "label": "Self-signed certificate" },
                    { "name": "rejectUnauthorized", "type": "boolean", "label": "Reject connections that are using unverified (self-signed) certificates", "required": true },
                    { "name": "followRedirect", "type": "boolean", "label": "Follow redirect", "required": true },
                    { "name": "useQuerystring", "type": "boolean", "label": "Disable serialization of multiple same query string keys as arrays", "required": true },
                    { "name": "gzip", "type": "boolean", "label": "Request compressed content", "required": true },
                    { "name": "useMtls", "type": "boolean", "label": "Use Mutual TLS", "required": true },
                    { "name": "contentType", "type": "select", "label": "Content type", "validate": { "enum": ["text/plain", "application/json", "application/xml", "text/xml", "text/html", "custom"] } },
                    { "name": "data", "type": "buffer", "label": "Request content" },
                    { "name": "followAllRedirects", "type": "boolean", "label": "Follow all redirect", "required": true }
                ]
            }
        },
        {
            "id": 10,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": { "array": "{{9.data.organic_results}}" },
            "metadata": {
                "designer": { "x": 2700, "y": 0, "name": "C Iterator organic_results[]" },
                "restore": {},
                "expect": [
                    { "name": "array", "type": "array", "label": "Array" }
                ]
            }
        },
        {
            "id": 11,
            "module": "builtin:Sleep",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Solo perfiles linkedin.com/in",
                "conditions": [
                    [
                        { "a": "{{10.link}}", "b": "https://www.linkedin.com/in/", "o": "text:startwith" }
                    ],
                    [
                        { "a": "{{10.link}}", "b": "https://{{5.C}}.linkedin.com/in/", "o": "text:startwith" }
                    ]
                ]
            },
            "mapper": { "delay": "{{1.sleep_perfil_s}}" },
            "metadata": {
                "designer": { "x": 3000, "y": 0, "name": "D Sleep entre perfiles" },
                "restore": {},
                "expect": [
                    { "name": "delay", "type": "uinteger", "label": "Delay", "required": true, "validate": { "max": 300, "min": 1 } }
                ]
            }
        },
        {
            "id": 12,
            "module": "apify:runActor",
            "version": 1,
            "parameters": { "__IMTCONN__": 2 },
            "mapper": {
                "actorId": "dev_fusion/linkedin-profile-scraper",
                "waitForFinish": true,
                "timeout": 300,
                "input": "{\"profileUrls\": [\"{{10.link}}\"], \"proxy\": {\"useApifyProxy\": true, \"apifyProxyGroups\": [\"RESIDENTIAL\"], \"apifyProxyCountry\": \"{{5.C}}\"}}"
            },
            "onerror": [
                {
                    "id": 121,
                    "module": "builtin:Break",
                    "version": 1,
                    "parameters": {
                        "retry": true,
                        "count": "3",
                        "interval": "1",
                        "enabled": true
                    },
                    "mapper": {},
                    "metadata": {
                        "designer": { "x": 3300, "y": 300, "name": "Break Apify 429/5xx (1s->3s->9s)" },
                        "restore": {},
                        "expect": [
                            { "name": "retry", "type": "boolean", "label": "Automatically complete execution" },
                            { "name": "count", "type": "number", "label": "Number of attempts" },
                            { "name": "interval", "type": "number", "label": "Interval between attempts (minutes)" }
                        ]
                    }
                }
            ],
            "metadata": {
                "designer": { "x": 3300, "y": 0, "name": "D Apify Run an Actor (sync)" },
                "restore": {
                    "expect": {
                        "actorId": { "label": "dev_fusion/linkedin-profile-scraper" },
                        "waitForFinish": { "label": "Yes" }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "apify" },
                            "label": "Apify (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:apify", "label": "Connection", "required": true }
                ],
                "expect": [
                    { "name": "actorId", "type": "text", "label": "Actor", "required": true },
                    { "name": "waitForFinish", "type": "boolean", "label": "Wait for the actor run to finish" },
                    { "name": "timeout", "type": "uinteger", "label": "Timeout (s)" },
                    { "name": "input", "type": "text", "label": "Input JSON" }
                ]
            }
        },
        {
            "id": 13,
            "module": "apify:getDatasetItems",
            "version": 1,
            "parameters": { "__IMTCONN__": 2 },
            "mapper": {
                "datasetId": "{{12.defaultDatasetId}}",
                "limit": 1,
                "clean": true
            },
            "metadata": {
                "designer": { "x": 3600, "y": 0, "name": "D Apify Get Dataset Items" },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "apify" },
                            "label": "Apify (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:apify", "label": "Connection", "required": true }
                ],
                "expect": [
                    { "name": "datasetId", "type": "text", "label": "Dataset ID", "required": true },
                    { "name": "limit", "type": "uinteger", "label": "Limit" },
                    { "name": "clean", "type": "boolean", "label": "Clean" }
                ]
            }
        },
        {
            "id": 14,
            "module": "util:SetVariable",
            "version": 1,
            "parameters": {},
            "mapper": {
                "name": "correo",
                "scope": "roundtrip",
                "value": "{{first(match(13.summary; \"[\\w.+-]+@[\\w-]+\\.[\\w.-]+\"; \"g\"))}}"
            },
            "metadata": {
                "designer": { "x": 3900, "y": 0, "name": "E Extrae correo por regex" },
                "restore": { "expect": { "scope": { "label": "One cycle" } } },
                "expect": [
                    { "name": "name", "type": "text", "label": "Variable name", "required": true },
                    { "name": "scope", "type": "select", "label": "Variable lifetime", "required": true, "validate": { "enum": ["roundtrip", "execution"] } },
                    { "name": "value", "type": "any", "label": "Variable value" }
                ]
            }
        },
        {
            "id": 15,
            "module": "google-sheets:searchRows",
            "version": 2,
            "parameters": { "__IMTCONN__": 1 },
            "filter": {
                "name": "Correo no vacio",
                "conditions": [
                    [
                        { "a": "{{14.value}}", "o": "exist" }
                    ]
                ]
            },
            "mapper": {
                "mode": "select",
                "spreadsheetId": "__SPREADSHEET_ID_LEADS__",
                "sheetId": "{{5.E}}",
                "includesHeaders": true,
                "filter": [
                    [
                        { "a": "url_linkedin", "b": "{{10.link}}", "o": "text:equal" }
                    ]
                ],
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
            },
            "metadata": {
                "designer": { "x": 4200, "y": 0, "name": "F Dedupe: Search Rows por url_linkedin" },
                "restore": {
                    "expect": {
                        "mode": { "label": "Select rows" },
                        "spreadsheetId": { "label": "iapro-leads (__SPREADSHEET_ID_LEADS__)" },
                        "includesHeaders": { "label": "Yes" }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "google" },
                            "label": "Google Sheets (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:google-restricted", "label": "Connection", "required": true }
                ]
            }
        },
        {
            "id": 16,
            "module": "google-sheets:addSheet",
            "version": 2,
            "parameters": { "__IMTCONN__": 1 },
            "filter": {
                "name": "Solo si dedupe devolvio cero filas",
                "conditions": [
                    [
                        { "a": "{{length(15.array)}}", "b": "0", "o": "number:equal" }
                    ]
                ]
            },
            "mapper": {
                "spreadsheetId": "__SPREADSHEET_ID_LEADS__",
                "title": "{{5.E}}",
                "rowCount": 1000,
                "columnCount": 9,
                "headers": [
                    "nombre", "cargo_actual", "empresa_actual", "ubicacion", "correo",
                    "url_linkedin", "headline", "resumen_about", "fecha_extraccion"
                ]
            },
            "onerror": [
                {
                    "id": 161,
                    "module": "builtin:Ignore",
                    "version": 1,
                    "parameters": {},
                    "mapper": {},
                    "metadata": {
                        "designer": { "x": 4500, "y": 300, "name": "Ignore: pestana ya existe" }
                    }
                }
            ],
            "metadata": {
                "designer": { "x": 4500, "y": 0, "name": "G Add a Sheet (si falta) con headers" },
                "restore": {
                    "expect": {
                        "spreadsheetId": { "label": "iapro-leads (__SPREADSHEET_ID_LEADS__)" }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "google" },
                            "label": "Google Sheets (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:google-restricted", "label": "Connection", "required": true }
                ]
            }
        },
        {
            "id": 17,
            "module": "google-sheets:addRow",
            "version": 2,
            "parameters": { "__IMTCONN__": 1 },
            "mapper": {
                "mode": "select",
                "insertUnformatted": false,
                "valueInputOption": "USER_ENTERED",
                "insertDataOption": "INSERT_ROWS",
                "spreadsheetId": "__SPREADSHEET_ID_LEADS__",
                "sheetId": "{{5.E}}",
                "includesHeaders": true,
                "values": {
                    "0": "{{13.fullName}}",
                    "1": "{{13.experience[1].title}}",
                    "2": "{{13.experience[1].companyName}}",
                    "3": "{{13.location}}",
                    "4": "{{14.value}}",
                    "5": "{{10.link}}",
                    "6": "{{13.headline}}",
                    "7": "{{13.summary}}",
                    "8": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}"
                }
            },
            "metadata": {
                "designer": { "x": 4800, "y": 0, "name": "G Add a Row (catalogo 9 columnas)" },
                "restore": {
                    "expect": {
                        "mode": { "label": "Select" },
                        "spreadsheetId": { "label": "iapro-leads (__SPREADSHEET_ID_LEADS__)" },
                        "includesHeaders": { "label": "Yes" },
                        "valueInputOption": { "label": "User entered" },
                        "insertDataOption": { "label": "Insert rows" }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": { "scoped": "true", "connection": "google" },
                            "label": "Google Sheets (iapro)"
                        }
                    }
                },
                "parameters": [
                    { "name": "__IMTCONN__", "type": "account:google-restricted", "label": "Connection", "required": true }
                ]
            }
        },
        {
            "id": 18,
            "module": "builtin:Sleep",
            "version": 1,
            "parameters": {},
            "mapper": { "delay": "{{1.sleep_paginacion_s}}" },
            "metadata": {
                "designer": { "x": 5100, "y": 0, "name": "H Sleep entre paginaciones" },
                "restore": {},
                "expect": [
                    { "name": "delay", "type": "uinteger", "label": "Delay", "required": true, "validate": { "max": 300, "min": 1 } }
                ]
            }
        },
        {
            "id": 19,
            "module": "datastore:AddReplaceRecord",
            "version": 1,
            "parameters": { "datastore": "__DATASTORE_ID__" },
            "mapper": {
                "key": "{{5.E}}",
                "overwrite": true,
                "record": {
                    "pestana": "{{5.E}}",
                    "procesados": "{{13.fullName}}",
                    "con_correo": "{{14.value}}",
                    "url_linkedin": "{{10.link}}",
                    "actualizado": "{{now}}"
                }
            },
            "metadata": {
                "designer": { "x": 5400, "y": 0, "name": "I Data Store: contadores por pestana" },
